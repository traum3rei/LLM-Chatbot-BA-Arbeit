@article{shumElizaXiaoIceChallenges2018,
  title = {From {{Eliza}} to {{XiaoIce}}: Challenges and Opportunities with Social Chatbots},
  shorttitle = {From {{Eliza}} to {{XiaoIce}}},
  author = {Shum, Heung-yeung and He, Xiao-dong and Li, Di},
  year = {2018},
