@article{chandrasekaranEvolutionSemanticSimilarity2022,
  title         = {Evolution of {{Semantic Similarity}} -- {{A Survey}}},
  author        = {Chandrasekaran, Dhivya and Mago, Vijay},
  year          = {2022},
  month         = mar,
  journal       = {ACM Computing Surveys},
  volume        = {54},
